<Application x:Class="ProjectManagementSystem.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:convert="clr-namespace:ProjectManagementSystem.WPF.Converters"
             xmlns:helpers="clr-namespace:ProjectManagementSystem.WPF.Helpers"
             xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#7B1FA2"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#009688"/>
            
            <Style x:Key="CustomSnackbar" TargetType="materialDesign:Snackbar">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <convert:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <convert:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <convert:StringToBrushConverter x:Key="StringToBrushConverter"/>
            <convert:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <convert:PageNumberConverter x:Key="PageNumberConverter"/>

            <Style x:Key="FilterPanelBorder" TargetType="Border">
                <Setter Property="Background" Value="#F7F5FB"/>
                <Setter Property="BorderBrush" Value="#E4DCEF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14,16,18"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
                <Setter Property="ClipToBounds" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="FilterHeaderText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#5E35B1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="FilterLabelText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#666"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="56"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="helpers:TextBoxInputRestriction.Kind" Value="Search"/>
                <Setter Property="ToolTip" Value="{x:Static helpers:InputFieldHints.Search}"/>
                <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed"/>
            </Style>

            <Style x:Key="FilterPageNumberTextBox" TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="helpers:TextBoxInputRestriction.Kind" Value="PageNumber"/>
                <Setter Property="ToolTip" Value="{x:Static helpers:InputFieldHints.PageNumber}"/>
            </Style>

            <Style x:Key="PaginationFooterBorder" TargetType="Border">
                <Setter Property="Background" Value="#F7F5FB"/>
                <Setter Property="BorderBrush" Value="#E4DCEF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,12,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="PaginationNavButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style x:Key="PaginationPageTextBox" TargetType="TextBox" BasedOn="{StaticResource FilterPageNumberTextBox}">
                <Setter Property="Width" Value="52"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MaxHeight" Value="36"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#D8CBEA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ClearFiltersButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="56"/>
            </Style>

            <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <Style x:Key="FilterDatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="160"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <Style x:Key="FilterPageSizeComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="56"/>
                <Setter Property="Width" Value="90"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
            </Style>

            <Style x:Key="FilterToolbarGrid" TargetType="Grid">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="AppDataGridBadgeBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="AppDataGridBadgeText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>

            <Style x:Key="DashboardStatCard" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="MinWidth" Value="148"/>
                <Setter Property="Width" Value="158"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DashboardStatPanel" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DashboardStatIcon" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="DashboardStatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#757575"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DashboardStatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DetailWindowRootBorder" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect" Value="{StaticResource MaterialDesignShadowDepth4}"/>
            </Style>

            <Style x:Key="DetailWindowHeaderBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="CornerRadius" Value="12,12,0,0"/>
                <Setter Property="Padding" Value="20,16"/>
            </Style>

            <Style x:Key="DetailWindowHeaderTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DetailWindowFooterBorder" TargetType="Border">
                <Setter Property="Background" Value="#F7F5FB"/>
                <Setter Property="BorderBrush" Value="#E4DCEF"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="CornerRadius" Value="0,0,12,12"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>

            <Style x:Key="DetailSectionCard" TargetType="Border">
                <Setter Property="Background" Value="#FBF9FE"/>
                <Setter Property="BorderBrush" Value="#E4DCEF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="DetailSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#5E35B1"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="DetailFieldLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="140"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#757575"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="DetailFieldValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#212121"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="DetailStatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="DetailStatusBadgeText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="DetailMiniStatCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E4DCEF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>

            <Style x:Key="DetailMiniStatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#757575"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <Style x:Key="DetailMiniStatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#5E35B1"/>
            </Style>

            <SolidColorBrush x:Key="TableSurfaceBrush" Color="#F3EEF9"/>
            <SolidColorBrush x:Key="TableRowBrush" Color="#FBF9FE"/>
            <SolidColorBrush x:Key="TableRowAltBrush" Color="#F0EAF8"/>
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#E6DBF3"/>
            <SolidColorBrush x:Key="TableBorderBrush" Color="#D8CBEA"/>
            <SolidColorBrush x:Key="TableLineBrush" Color="#E2D6F0"/>

            <Style x:Key="AppDataGridHostBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TableSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <Style x:Key="DataGridCellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Foreground" Value="#333"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            </Style>

            <Style x:Key="AppDataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="Stretch"
                                    SnapsToDevicePixels="True">
                                <Grid VerticalAlignment="Stretch">
                                    <ContentPresenter VerticalAlignment="Stretch"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DDD0F0"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AppDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource TableHeaderBrush}"/>
                <Setter Property="Foreground" Value="#4A148C"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{StaticResource TableLineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="SeparatorBrush" Value="{StaticResource TableLineBrush}"/>
            </Style>

            <Style x:Key="AppDataGridActionsHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="AppDataGridActionsCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="AppDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Height" Value="46"/>
                <Setter Property="MinHeight" Value="46"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource TableRowBrush}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource TableRowAltBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E8DEF5"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DDD0F0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AppDataGridTextColumnStyle" TargetType="DataGridTextColumn">
                <Setter Property="ElementStyle" Value="{StaticResource DataGridCellTextStyle}"/>
                <Setter Property="EditingElementStyle" Value="{StaticResource DataGridCellTextStyle}"/>
            </Style>

            <Style x:Key="AppDataGridTemplateColumnStyle" TargetType="DataGridTemplateColumn">
                <Setter Property="CellStyle" Value="{StaticResource AppDataGridCellStyle}"/>
            </Style>

            <Style x:Key="AppDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource TableRowBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowHeight" Value="46"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource TableRowAltBrush}"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableLineBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TableLineBrush}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="CanUserResizeColumns" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CellStyle" Value="{StaticResource AppDataGridCellStyle}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppDataGridColumnHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource AppDataGridRowStyle}"/>
                <Setter Property="helpers:DataGridHelper.AutoCenterTextColumns" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>