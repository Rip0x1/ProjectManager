<Window x:Class="ProjectManagementSystem.WPF.Views.AuditLogDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Запись журнала"
        MinWidth="640" MinHeight="420"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="CanResizeWithGrip"
        ShowActivated="True">

    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Effect="{StaticResource MaterialDesignElevationShadow4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <materialDesign:PackIcon Kind="ClipboardTextClock" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Что произошло"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Width="32" Height="32"
                            FontSize="16"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#F7F5FB" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Details}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Когда" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimestampText}" Margin="0,0,12,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Кто" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UserDisplay}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserEmail}" Margin="0,0,12,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Действие" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ActionText}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Раздел" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EntityTypeText}" Margin="0,0,12,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Название" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding EntityName}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ID записи" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Id}" Margin="0,0,12,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="ID объекта" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding EntityIdText}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Button Content="Закрыть"
                        HorizontalAlignment="Right"
                        Width="120"
                        Height="36"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
