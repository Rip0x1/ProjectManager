<Window x:Class="ProjectManagementSystem.WPF.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:convert="clr-namespace:ProjectManagementSystem.WPF.Converters"
        Title="Детали проекта"
        WindowStartupLocation="CenterOwner"
        MinWidth="560" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <convert:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convert:InverseBoolToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <convert:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Border Style="{StaticResource DetailWindowRootBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DetailWindowHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="FolderOpen" Width="28" Height="28" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Детали проекта" Style="{StaticResource DetailWindowHeaderTitle}" Margin="12,0,0,0"/>
                        <Button Grid.Column="2"
                                Click="CloseButton_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                ToolTip="Закрыть">
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
                    <StackPanel>
                        <Border Style="{StaticResource DetailSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Основная информация" Style="{StaticResource DetailSectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" Style="{StaticResource DetailFieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentProject.Name}" Style="{StaticResource DetailFieldValue}" FontWeight="SemiBold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус" Style="{StaticResource DetailFieldLabel}"/>
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Style="{StaticResource DetailStatusBadge}"
                                            Background="{Binding CurrentProject.StatusColor}">
                                        <TextBlock Text="{Binding CurrentProject.StatusText}" Style="{StaticResource DetailStatusBadgeText}"/>
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Руководитель" Style="{StaticResource DetailFieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProject.ManagerName}" Style="{StaticResource DetailFieldValue}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата создания" Style="{StaticResource DetailFieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProject.CreatedAtText}" Style="{StaticResource DetailFieldValue}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Дедлайн" Style="{StaticResource DetailFieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentProject.DeadlineText}" Style="{StaticResource DetailFieldValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Описание" Style="{StaticResource DetailSectionTitle}"/>
                                <Border Background="White" BorderBrush="#E4DCEF" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="80">
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding CurrentProject.Description}" TextWrapping="Wrap" LineHeight="22" Foreground="#424242"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailSectionCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Статистика проекта" Style="{StaticResource DetailSectionTitle}"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource DetailMiniStatCard}" Cursor="Hand" ToolTip="Открыть участников проекта">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ViewMembersCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#5E35B1" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentProject.ParticipantsCount}" Style="{StaticResource DetailMiniStatValue}" Foreground="#5E35B1" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Участников" Style="{StaticResource DetailMiniStatLabel}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailMiniStatCard}" Cursor="Hand" ToolTip="Открыть список задач">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ViewTasksCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ClipboardList" Width="22" Height="22" Foreground="#1976D2" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentProject.TasksCount}" Style="{StaticResource DetailMiniStatValue}" Foreground="#1976D2" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Задач" Style="{StaticResource DetailMiniStatLabel}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailMiniStatCard}" Cursor="Hand" ToolTip="Открыть комментарии проекта">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ViewCommentsCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CommentTextMultiple" Width="22" Height="22" Foreground="#00897B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentProject.CommentsCount}" Style="{StaticResource DetailMiniStatValue}" Foreground="#00897B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Комментариев" Style="{StaticResource DetailMiniStatLabel}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailSectionCard}" Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Paperclip" Width="20" Height="20" Foreground="#5E35B1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Вложения" Style="{StaticResource DetailSectionTitle}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            BorderBrush="#5E35B1"
                                            Foreground="#5E35B1"
                                            Command="{Binding AddAttachmentCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Прикрепить" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Background="White" BorderBrush="#E4DCEF" BorderThickness="1" CornerRadius="8" Padding="4,0"
                                        Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0EBF7" BorderThickness="0,0,0,1" Padding="8,10" ClipToBounds="True">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button Content="Просмотр"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,4,0"
                                                                    Foreground="#5E35B1"
                                                                    BorderBrush="#5E35B1"
                                                                    Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Скачать"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,4,0"
                                                                    Foreground="#2196F3"
                                                                    BorderBrush="#2196F3"
                                                                    Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Удалить"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Padding="8,4"
                                                                    Foreground="#F44336"
                                                                    BorderBrush="#F44336"
                                                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FileName}"/>
                                                            <TextBlock Foreground="#9E9E9E" FontSize="11">
                                                                <Run Text="{Binding FileSizeText, Mode=OneWay}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding UploadedAtText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Background="#FAFAFA" BorderBrush="#E4DCEF" BorderThickness="1" CornerRadius="8" Padding="16"
                                        Visibility="{Binding HasAttachments, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FileHidden" Width="32" Height="32" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Нет вложений" Foreground="#9E9E9E" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource DetailWindowFooterBorder}">
                    <Button Content="Закрыть"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Right"
                            MinWidth="120"
                            MinHeight="40"
                            Click="CloseButton_Click"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
