<Window x:Class="ProjectManagerApp.Views.ProjectCommentsAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:ProjectManagementSystem.WPF.Helpers"
        Title="Добавить комментарий к проекту" 
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Effect="{StaticResource MaterialDesignElevationShadow4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" 
                    CornerRadius="8,8,0,0" Height="50">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <materialDesign:PackIcon Kind="CommentPlus" Width="24" Height="24" 
                                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Добавить комментарий к проекту" 
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Width="32" Height="32"
                            FontSize="16"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="16">
                <StackPanel>
                    <TextBlock Text="{Binding ProjectName}" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               Margin="0,0,0,16"/>
                    
                    <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Опишите вопрос или замечание..."
                             helpers:TextBoxInputRestriction.Kind="Comment"
                             ToolTip="{x:Static helpers:InputFieldHints.Comment}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="120"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <Button Content="Прикрепить файл"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding AddPendingAttachmentCommand}"/>

                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="Убрать"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="8,4"
                                            Foreground="#F44336"
                                            BorderBrush="#F44336"
                                            Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" 
                    CornerRadius="0,0,8,8" Height="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" 
                            Content="Добавить комментарий" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="8,0,16,0"
                            Command="{Binding AddCommentCommand}"
                            IsEnabled="{Binding CanAddComment}"/>
                    
                    <Button Grid.Column="2" 
                            Content="Закрыть" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="8,0,8,0"
                            Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
