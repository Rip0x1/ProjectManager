<UserControl x:Class="ProjectManagementSystem.WPF.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:convert="clr-namespace:ProjectManagementSystem.WPF.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="BeautifulSnackbar" TargetType="materialDesign:Snackbar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <convert:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convert:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="#80000000" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                                   Width="150" Height="10"
                                   Foreground="{DynamicResource MaterialDesignShadowBrush}"
                                   Margin="0,0,0,5"/>
                <TextBlock Text="Загрузка данных..." 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Grid Margin="0,0,0,4" Style="{StaticResource FilterToolbarGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                         Style="{StaticResource FilterTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по ID задачи, ID проекта, названию или исполнителю"/>

                    <ComboBox Grid.Column="1" 
                          Style="{StaticResource FilterPageSizeComboBox}"
                          SelectedValue="{Binding PageSize}"
                          SelectedValuePath="Tag"
                          materialDesign:HintAssist.Hint="На стр.">
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="25" Tag="25"/>
                        <ComboBoxItem Content="50" Tag="50"/>
                        <ComboBoxItem Content="100" Tag="100"/>
                    </ComboBox>

                    <Button Grid.Column="2" Margin="8,0,0,0"
                        VerticalAlignment="Center" MinHeight="56"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        Command="{Binding CreateTaskCommand}"
                        Visibility="{Binding CanCreateTasks, Converter={StaticResource BooleanToVisibilityConverter}}" Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Создать" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button x:Name="ColumnsButton" Grid.Column="3" Margin="8,0,0,0"
                        VerticalAlignment="Center" MinHeight="56"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="ColumnsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewColumn" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Столбцы"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ColumnsPopup"
                           PlacementTarget="{Binding ElementName=ColumnsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                MinWidth="200"
                                Effect="{StaticResource MaterialDesignElevationShadow2}">
                            <StackPanel>
                                <TextBlock Text="Отображаемые столбцы"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ColumnOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}"
                                                      IsChecked="{Binding IsVisible}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Grid.Column="4"
                            Style="{StaticResource ClearFiltersButton}"
                            Command="{Binding ClearFiltersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterRemove" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Сбросить фильтры"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource FilterPanelBorder}" ClipToBounds="False">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,2,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20"
                                                     Foreground="#5E35B1" VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>

                            <TextBlock Text="Статус:" Style="{StaticResource FilterLabelText}"/>
                            <ComboBox Style="{StaticResource FilterComboBox}"
                                      Width="145"
                                      SelectedValue="{Binding SelectedStatusFilter}"
                                      SelectedValuePath="Tag"
                                      materialDesign:HintAssist.Hint="Все статусы">
                                <ComboBoxItem Content="Все статусы" Tag="-1"/>
                                <ComboBoxItem Content="Новая" Tag="0"/>
                                <ComboBoxItem Content="В работе" Tag="1"/>
                                <ComboBoxItem Content="На проверке" Tag="2"/>
                                <ComboBoxItem Content="Завершена" Tag="3"/>
                                <ComboBoxItem Content="Отложено" Tag="4"/>
                                <ComboBoxItem Content="Проблема" Tag="5"/>
                            </ComboBox>

                            <TextBlock Text="Приоритет:" Style="{StaticResource FilterLabelText}" Margin="4,0,8,0"/>
                            <ComboBox Style="{StaticResource FilterComboBox}"
                                      Width="145"
                                      SelectedValue="{Binding SelectedPriorityFilter}"
                                      SelectedValuePath="Tag"
                                      materialDesign:HintAssist.Hint="Все приоритеты">
                                <ComboBoxItem Content="Все приоритеты" Tag="-1"/>
                                <ComboBoxItem Content="Низкий" Tag="0"/>
                                <ComboBoxItem Content="Средний" Tag="1"/>
                                <ComboBoxItem Content="Высокий" Tag="2"/>
                                <ComboBoxItem Content="Критический" Tag="3"/>
                            </ComboBox>

                            <TextBlock Text="Исполнитель:" Style="{StaticResource FilterLabelText}" Margin="4,0,8,0"/>
                            <ComboBox Style="{StaticResource FilterComboBox}"
                                      Width="165"
                                      ItemsSource="{Binding AssigneeFilterUsers}"
                                      SelectedItem="{Binding SelectedAssigneeFilterUser}"
                                      DisplayMemberPath="FullName"
                                      materialDesign:HintAssist.Hint="Все исполнители"/>

                            <TextBlock Text="Срок с:" Style="{StaticResource FilterLabelText}" Margin="4,0,8,0"/>
                            <DatePicker Style="{StaticResource FilterDatePicker}"
                                        Width="145"
                                        SelectedDate="{Binding FilterDueFrom}"/>

                            <TextBlock Text="по:" Style="{StaticResource FilterLabelText}" Margin="0,0,8,0"/>
                            <DatePicker Style="{StaticResource FilterDatePicker}"
                                        Width="145"
                                        SelectedDate="{Binding FilterDueTo}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">

                <Border Style="{StaticResource AppDataGridHostBorder}">
                <DataGrid x:Name="TasksGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          ItemsSource="{Binding PagedTasks}"
                          AutoGenerateColumns="False"
                          Sorting="TasksGrid_Sorting"
                          MouseDoubleClick="TasksGrid_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridTextColumn" BasedOn="{StaticResource AppDataGridTextColumnStyle}"/>
                        <Style TargetType="DataGridTemplateColumn" BasedOn="{StaticResource AppDataGridTemplateColumnStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColId" Header="ID задачи" Binding="{Binding Id}" SortMemberPath="Id" Width="Auto" MinWidth="72"/>
                        <DataGridTextColumn x:Name="ColTitle" Header="Название" Binding="{Binding Title}" SortMemberPath="Title" Width="*" MinWidth="120"/>
                        <DataGridTemplateColumn x:Name="ColDescription" Header="Описание" SortMemberPath="Description" Width="1.4*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DescriptionShort}"
                                               Style="{StaticResource DataGridCellTextStyle}"
                                               ToolTip="{Binding DescriptionToolTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColStatus" Header="Статус" SortMemberPath="Status" Width="Auto" MinWidth="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppDataGridBadgeBorder}"
                                            Background="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource AppDataGridBadgeText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColPriority" Header="Приоритет" SortMemberPath="Priority" Width="Auto" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppDataGridBadgeBorder}"
                                            Background="{Binding PriorityColor, Converter={StaticResource StringToBrushConverter}}">
                                        <TextBlock Text="{Binding PriorityText}" Style="{StaticResource AppDataGridBadgeText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColProjectName" Header="Проект" Binding="{Binding ProjectName}" SortMemberPath="ProjectName" Width="Auto" MinWidth="110"/>
                        <DataGridTemplateColumn x:Name="ColAssigneeDisplayName" Header="Исполнитель" SortMemberPath="AssigneeDisplayName" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            ToolTipService.InitialShowDelay="250"
                                            ToolTipService.ShowDuration="60000">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="ToolTip" Value="{Binding AssigneeToolTip}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AssigneeToolTip}" Value="">
                                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AssigneeDisplayName}"
                                                   Style="{StaticResource DataGridCellTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColDueDateText" Header="Срок" Binding="{Binding DueDateText}" SortMemberPath="DueDateText" Width="Auto" MinWidth="88"/>
                        <DataGridTextColumn x:Name="ColCompletedAtText" Header="Факт" Binding="{Binding CompletedAtText}" SortMemberPath="CompletedAtText" Width="Auto" MinWidth="88"/>
                        <DataGridTextColumn x:Name="ColAuthorName" Header="Автор" Binding="{Binding AuthorName}" SortMemberPath="AuthorName" Width="Auto" MinWidth="100"/>
                        <DataGridTextColumn x:Name="ColCreatedAtText" Header="Создана" Binding="{Binding CreatedAtText}" SortMemberPath="CreatedAtText" Width="Auto" MinWidth="120"/>
                        <DataGridTemplateColumn x:Name="ColActions" Header="Действия"
                                                CanUserSort="False"
                                                Width="112"
                                                MinWidth="112"
                                                HeaderStyle="{StaticResource AppDataGridActionsHeaderStyle}"
                                                CellStyle="{StaticResource AppDataGridActionsCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.ViewCommentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                Margin="0"
                                                ToolTip="Комментарии">
                                            <materialDesign:PackIcon Kind="Comment" Width="18" Height="18" Foreground="#4CAF50"/>
                                        </Button>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.CanManageTasks, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="32" Height="32"
                                                    Padding="0"
                                                    Margin="0"
                                                    ToolTip="Редактировать">
                                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="#2196F3"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="32" Height="32"
                                                    Padding="0"
                                                    Margin="0"
                                                    ToolTip="Удалить">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PaginationFooterBorder}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding FirstPageCommand}" ToolTip="Первая страница">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding PreviousPageCommand}" ToolTip="Предыдущая">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>
                    <TextBlock Text="Стр." VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#666"/>
                    <TextBox Style="{StaticResource PaginationPageTextBox}"
                             Text="{Binding CurrentPage, Converter={StaticResource PageNumberConverter}, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,10,0" Foreground="#666">
                        <Run Text="из "/><Run Text="{Binding TotalPages}"/>
                    </TextBlock>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding NextPageCommand}" ToolTip="Следующая">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding LastPageCommand}" ToolTip="Последняя страница">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
