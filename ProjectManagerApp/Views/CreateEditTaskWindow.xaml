<Window x:Class="ProjectManagementSystem.WPF.Views.CreateEditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ProjectManagementSystem.WPF.Converters"
        xmlns:helpers="clr-namespace:ProjectManagementSystem.WPF.Helpers"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
        <local:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="15" Effect="{StaticResource MaterialDesignShadowDepth5}">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="15,15,0,0" Padding="25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding WindowTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                            Click="Close_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            ToolTip="Закрыть">
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25,20">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Название задачи *" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Например: Подготовить отчёт"
                             helpers:TextBoxInputRestriction.Kind="Title"
                             ToolTip="{x:Static helpers:InputFieldHints.TaskTitle}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                            <TextBlock Text="Описание задачи" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Детали, шаги, критерии готовности"
                             helpers:TextBoxInputRestriction.Kind="LongDescription"
                             ToolTip="{x:Static helpers:InputFieldHints.TaskDescription}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20"/>

                            <TextBlock Text="Проект" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              FontSize="14"
                              Margin="0,0,0,20"/>

                            <TextBlock Text="Исполнители" Style="{StaticResource LabelStyle}"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="140" Margin="0,0,0,20">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AssigneeChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding FullName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Статус *" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox SelectedValue="{Binding SelectedStatus}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="14">
                                        <ComboBoxItem Content="Новая" Tag="0"/>
                                        <ComboBoxItem Content="В работе" Tag="1"/>
                                        <ComboBoxItem Content="На проверке" Tag="2"/>
                                        <ComboBoxItem Content="Завершена" Tag="3"/>
                                        <ComboBoxItem Content="Отложено" Tag="4"/>
                                        <ComboBoxItem Content="Проблема" Tag="5"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Приоритет *" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox SelectedValue="{Binding SelectedPriority}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="14">
                                        <ComboBoxItem Content="Низкий" Tag="0"/>
                                        <ComboBoxItem Content="Средний" Tag="1"/>
                                        <ComboBoxItem Content="Высокий" Tag="2"/>
                                        <ComboBoxItem Content="Критический" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Срок исполнения" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding DueDate}"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Фактическая дата" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding CompletedAt}"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Вложения" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Добавить файл"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddAttachmentCommand}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="Убрать"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Padding="8,4"
                                                    Foreground="#F44336"
                                                    BorderBrush="#F44336"
                                                    Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding FileName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding ExistingAttachments}" Margin="0,0,0,12"
                                          Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Просмотр"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Padding="8,4"
                                                        Margin="0,0,4,0"
                                                        Foreground="#5E35B1"
                                                        BorderBrush="#5E35B1"
                                                        Command="{Binding DataContext.PreviewExistingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Удалить"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Padding="8,4"
                                                        Foreground="#F44336"
                                                        BorderBrush="#F44336"
                                                        Command="{Binding DataContext.RemoveExistingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="* — обязательные поля"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#757575"
                               Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                    Background="#F5F5F5"
                    CornerRadius="0,0,15,15"
                    Padding="25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Panel.ZIndex="1000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                   Width="150" Height="10"
                                   Foreground="{DynamicResource MaterialDesignShadowBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1"
                            Content="Отмена"
                            Click="Cancel_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120"
                            Height="40"
                            Margin="0,0,15,0"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"/>

                        <Button Grid.Column="2"
                            Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Width="120"
                            Height="40"
                            IsEnabled="{Binding CanSave}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
