<Window x:Class="ProjectManagerApp.Views.TaskCommentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ProjectManagementSystem.WPF.Converters"
        xmlns:helpers="clr-namespace:ProjectManagementSystem.WPF.Helpers"
        Title="Комментарии к задаче"
        MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <Style x:Key="CommentCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <Style x:Key="AuthorTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="DateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="16,16,16,8" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding TaskTitle}" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           FontWeight="Bold"/>
                <TextBlock Text="Комментарии к задаче" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Style="{StaticResource CommentCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding AuthorName}" 
                                               Style="{StaticResource AuthorTextStyle}"/>
                                    <TextBlock Text="{Binding FormattedCreatedAt}" 
                                               Style="{StaticResource DateTextStyle}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Content}" 
                                           TextWrapping="Wrap"
                                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                                           Margin="0,0,0,8"/>

                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding Attachments}"
                                              Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Просмотр"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="8,4"
                                                            Margin="0,0,4,0"
                                                            Foreground="#5E35B1"
                                                            BorderBrush="#5E35B1"
                                                            Command="{Binding DataContext.PreviewCommentAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Удалить"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="8,4"
                                                            Foreground="#F44336"
                                                            BorderBrush="#F44336"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.DeleteCommentAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Paperclip" Width="16" Height="16"
                                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FileName}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FileName}"/>
                                                    <TextBlock Text="{Binding FileSizeText, StringFormat=' ({0})'}"
                                                               Foreground="Gray"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Прикрепить файл"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding CanAddAttachment, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.AddAttachmentToCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Удалить комментарий"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#F44336"
                                            BorderBrush="#F44336"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="2" Margin="16,0,16,16" Padding="16">
            <StackPanel>
                <TextBlock Text="Добавить комментарий" 
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,12"/>
                
                <TextBox Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Ваш комментарий к задаче..."
                         helpers:TextBoxInputRestriction.Kind="Comment"
                         ToolTip="{x:Static helpers:InputFieldHints.Comment}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,8"/>

                <Button Content="Прикрепить файл"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Command="{Binding AddPendingAttachmentCommand}"/>

                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="Убрать"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="8,4"
                                        Foreground="#F44336"
                                        BorderBrush="#F44336"
                                        Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FileName}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Добавить комментарий" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding AddCommentCommand}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanAddComment}"/>
                    <Button Content="Закрыть" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
