<UserControl x:Class="ProjectManagementSystem.WPF.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:ProjectManagementSystem.WPF.ViewModels"
             xmlns:convert="clr-namespace:ProjectManagementSystem.WPF.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuditLogsViewModel}">

    <UserControl.Resources>
        <convert:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convert:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="150" Height="10"
                             Foreground="{DynamicResource MaterialDesignShadowBrush}"
                             Margin="0,0,0,5"/>
                <TextBlock Text="Загрузка журнала..."
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Grid Margin="0,0,0,4" Style="{StaticResource FilterToolbarGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource FilterTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Поиск по ID, пользователю, объекту или деталям"/>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource FilterPageSizeComboBox}"
                              SelectedValue="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              materialDesign:HintAssist.Hint="На стр.">
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="25" Tag="25"/>
                        <ComboBoxItem Content="50" Tag="50"/>
                        <ComboBoxItem Content="100" Tag="100"/>
                    </ComboBox>

                    <Button x:Name="ColumnsButton" Grid.Column="2" Margin="8,0,0,0"
                            VerticalAlignment="Center" MinHeight="56"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="ColumnsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewColumn" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Столбцы"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ColumnsPopup"
                           PlacementTarget="{Binding ElementName=ColumnsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="4" Padding="12" MinWidth="200"
                                Effect="{StaticResource MaterialDesignElevationShadow2}">
                            <StackPanel>
                                <TextBlock Text="Отображаемые столбцы" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ColumnOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}"
                                                      IsChecked="{Binding IsVisible}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="3"
                            Style="{StaticResource ClearFiltersButton}"
                            Command="{Binding ClearFiltersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterRemove" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Сбросить фильтры"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4"
                            Style="{StaticResource ClearFiltersButton}"
                            Foreground="#C62828"
                            Command="{Binding ClearLogsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Очистить журнал"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource FilterPanelBorder}" ClipToBounds="False">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClipboardTextClock" Width="20" Height="20"
                                                     Foreground="#5E35B1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Действие:" Style="{StaticResource FilterLabelText}"/>
                            <ComboBox Style="{StaticResource FilterComboBox}"
                                      Width="180"
                                      SelectedValue="{Binding SelectedAction}"
                                      SelectedValuePath="Tag"
                                      materialDesign:HintAssist.Hint="Все действия">
                                <ComboBoxItem Content="Все действия" Tag="All"/>
                                <ComboBoxItem Content="Вход" Tag="Login"/>
                                <ComboBoxItem Content="Выход" Tag="Logout"/>
                                <ComboBoxItem Content="Неудачный вход" Tag="LoginFailed"/>
                                <ComboBoxItem Content="Создание" Tag="Create"/>
                                <ComboBoxItem Content="Изменение" Tag="Update"/>
                                <ComboBoxItem Content="Удаление" Tag="Delete"/>
                                <ComboBoxItem Content="Очистка журнала" Tag="Clear"/>
                            </ComboBox>
                            <TextBlock Text="Объект:" Style="{StaticResource FilterLabelText}" Margin="4,0,8,0"/>
                            <ComboBox Style="{StaticResource FilterComboBox}"
                                      Width="200"
                                      SelectedValue="{Binding SelectedEntityType}"
                                      SelectedValuePath="Tag"
                                      materialDesign:HintAssist.Hint="Все объекты">
                                <ComboBoxItem Content="Все объекты" Tag="All"/>
                                <ComboBoxItem Content="Пользователь" Tag="User"/>
                                <ComboBoxItem Content="Проект" Tag="Project"/>
                                <ComboBoxItem Content="Задача" Tag="Task"/>
                                <ComboBoxItem Content="Комментарий" Tag="Comment"/>
                                <ComboBoxItem Content="Участник проекта" Tag="ProjectUser"/>
                                <ComboBoxItem Content="Исполнитель" Tag="TaskAssignee"/>
                                <ComboBoxItem Content="Вложение задачи" Tag="TaskAttachment"/>
                                <ComboBoxItem Content="Вложение проекта" Tag="ProjectAttachment"/>
                                <ComboBoxItem Content="Вложение комментария" Tag="CommentAttachment"/>
                            </ComboBox>
                            <TextBlock Text="С:" Style="{StaticResource FilterLabelText}" Margin="4,0,8,0"/>
                            <DatePicker Style="{StaticResource FilterDatePicker}"
                                        SelectedDate="{Binding FilterFrom}"/>
                            <TextBlock Text="по:" Style="{StaticResource FilterLabelText}" Margin="0,0,8,0"/>
                            <DatePicker Style="{StaticResource FilterDatePicker}"
                                        SelectedDate="{Binding FilterTo}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource AppDataGridHostBorder}">
                    <DataGrid x:Name="LogsGrid"
                              Style="{StaticResource AppDataGridStyle}"
                              ItemsSource="{Binding Logs}"
                              AutoGenerateColumns="False"
                              PreviewMouseLeftButtonUp="LogsGrid_PreviewMouseLeftButtonUp">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridTextColumn" BasedOn="{StaticResource AppDataGridTextColumnStyle}"/>
                            <Style TargetType="DataGridTemplateColumn" BasedOn="{StaticResource AppDataGridTemplateColumnStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColId" Header="ID" Binding="{Binding Id}" SortMemberPath="Id" Width="Auto" MinWidth="56"/>
                            <DataGridTextColumn x:Name="ColTimestampText" Header="Время" Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="Auto" MinWidth="140"/>
                            <DataGridTextColumn x:Name="ColUserDisplay" Header="Пользователь" Binding="{Binding UserDisplay}" SortMemberPath="UserName" Width="*" MinWidth="140"/>
                            <DataGridTemplateColumn x:Name="ColActionText" Header="Действие" SortMemberPath="ActionText" Width="Auto" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AppDataGridBadgeBorder}"
                                                Background="{Binding ActionColor, Converter={StaticResource StringToBrushConverter}}">
                                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource AppDataGridBadgeText}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColEntityTypeText" Header="Объект" Binding="{Binding EntityTypeText}" SortMemberPath="EntityTypeText" Width="Auto" MinWidth="120"/>
                            <DataGridTextColumn x:Name="ColEntityIdText" Header="ID объекта" Binding="{Binding EntityIdText}" SortMemberPath="EntityId" Width="Auto" MinWidth="88"/>
                            <DataGridTextColumn x:Name="ColEntityName" Header="Название" Binding="{Binding EntityName}" SortMemberPath="EntityName" Width="*" MinWidth="140"/>
                            <DataGridTextColumn x:Name="ColDetails" Header="Детали" Binding="{Binding Details}" SortMemberPath="Details" Width="1.2*" MinWidth="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PaginationFooterBorder}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding FirstPageCommand}" ToolTip="Первая страница">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding PreviousPageCommand}" ToolTip="Предыдущая">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>
                    <TextBlock Text="Стр." VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#666"/>
                    <TextBox Style="{StaticResource PaginationPageTextBox}"
                             Text="{Binding CurrentPage, Converter={StaticResource PageNumberConverter}, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,10,0" Foreground="#666">
                        <Run Text="из "/><Run Text="{Binding TotalPages}"/>
                    </TextBlock>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding NextPageCommand}" ToolTip="Следующая">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource PaginationNavButton}" Command="{Binding LastPageCommand}" ToolTip="Последняя страница">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
